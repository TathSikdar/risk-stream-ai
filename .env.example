# RiskStream AI Environment Configuration

# 1. AI Engine (Python)
# ---------------------
# Set to 'NVIDIA' to use NVIDIA NIM endpoints, 'GEMINI' for Google Gemini, or 'OPENAI' for GPT models.
LLM_PROVIDER=GEMINI

# If provider is NVIDIA
NVIDIA_API_KEY=your_nvidia_nim_api_key_here

# If provider is GEMINI
GOOGLE_API_KEY=your_google_gemini_api_key_here

# If provider is OPENAI
OPENAI_API_KEY=your_openai_api_key_here

# 3. Search API (Adverse Media)
# ---------------------
# Used for real-time news investigations.
TAVILY_API_KEY=your_tavily_api_key_here

# 4. Watchlist API (Sanctions)
# ---------------------
# Used for real-time sanctions checking (OpenSanctions API).
# Get a free key at: https://www.opensanctions.org/
OPENSANCTIONS_API_KEY=your_opensanctions_api_key_here

# 2. BFF (Node.js)
# ---------------------
PORT=5000
JWT_SECRET=risk_stream_ai_super_secret_key
AI_ENGINE_URL=http://localhost:8000

# Database Engine: 'SQLITE' or 'POSTGRES'
DB_ENGINE=SQLITE

# If engine is POSTGRES
PGHOST=localhost
PGUSER=postgres
PGDATABASE=risk_stream_ai
PGPASSWORD=your_password
PGPORT=5432
